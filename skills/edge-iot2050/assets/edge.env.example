# Copy to the approved deployment bundle as edge.env and replace the placeholder.
EMQX_HOST=broker.example.invalid
EMQX_TLS_PORT=8883
OPENAUT_POINTS=/etc/openaut/current/points.json
OPENAUT_CERT_DIR=/etc/openaut/current/certs
OPENAUT_SPOOL=/var/lib/openaut/spool.sqlite
OPENAUT_SPOOL_MAX_ROWS=100000
OPENAUT_MQTT_MAX_INFLIGHT=20
OPENAUT_READY_FILE=/var/lib/openaut/mqtt.ready
