[Unit]
Description=openAut IOT2050 edge agent (field -> EMQX over mutual TLS, store-and-forward)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configuration and keys are root-owned; the service receives group-read access only.
User=openaut
Group=openaut
EnvironmentFile=/etc/openaut/current/edge.env
ExecStartPre=/opt/openaut-edge/current/venv/bin/python /opt/openaut-edge/current/scripts/edge_agent.py --check-config /etc/openaut/current/points.json
ExecStart=/opt/openaut-edge/current/venv/bin/python /opt/openaut-edge/current/scripts/edge_agent.py
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openaut
ProtectHome=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
